# Kopiere diese Datei nach .env und trage deine Werte ein.
# .env wird NICHT committet (siehe .gitignore).

# Zeitzone (steuert die Zeitbasis des Yazio-Sync-Schedulers)
TZ=Europe/Berlin

# SQLite-Datei im gemounteten Volume
DB_PATH=/data/cockpit.db

# --- Yazio (inoffizielle API, über yazio-exporter) ---
# Login mit deinen normalen Yazio-Zugangsdaten. Funktioniert nicht mit 2FA.
YAZIO_EMAIL=deine@mail.de
YAZIO_PASSWORD=deinPasswort

# Automatischer Sync im Hintergrund (Intervall in Minuten)
YAZIO_SYNC_ENABLED=true
YAZIO_SYNC_INTERVAL_MINUTES=30
